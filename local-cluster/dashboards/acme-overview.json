    {
      "type": "timeseries",
      "title": "网关请求速率（按状态码）",
      "description": "429 = 限流（demo.sh ratelimit），503 = 下游不可用 / 熔断（demo.sh breaker）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (label_replace(rate(http_server_request_duration_seconds_count{service=\"acme-gateway\"}[1m]), \"code\", \"$1\", \"http_response_status_code\", \"(.*)\")) or sum by (code) (label_replace(rate(http_server_requests_seconds_count{service=\"acme-gateway\", uri!~\"/actuator.*\"}[1m]), \"code\", \"$1\", \"status\", \"(.*)\"))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
