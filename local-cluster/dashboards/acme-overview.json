    {
      "type": "stat",
      "title": "发件箱积压",
      "description": "order-service 的 outbox_event 中 status=0 的事件数；持续上涨说明 MQ 不可用（demo.sh outbox）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
